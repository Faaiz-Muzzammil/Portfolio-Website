# Copy to .env.local and fill in. .gitignore covers .env*, so the real
# values never leave the machine; this file is the checked-in record of
# which names the app actually reads.
#
# Both are read in src/app/api/contact/route.ts and nowhere else. Neither
# is NEXT_PUBLIC_, so neither reaches the browser bundle — the contact
# form posts to a route handler and the key stays on the server.

# Resend API key, from https://resend.com/api-keys — starts with `re_`.
# Without it the contact route answers 503 and offers the direct mailto
# instead of pretending to send.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# THE ENVELOPE SENDER, AND THE ONE THAT IS EASY TO GET WRONG.
#
# This must be a mailbox on a domain verified at
# https://resend.com/domains. The local part does not have to be a real
# inbox — replies are addressed to the visitor via `reply_to`, not to
# this — but the DOMAIN must be verified or Resend refuses the send.
#
# Do NOT set this to `onboarding@resend.dev`. That is Resend's shared
# sandbox sender and it may only deliver to the address that registered
# the account; pointed at any other mailbox it returns 403, which is a
# contact form that accepts messages and silently drops them.
CONTACT_FROM=Portfolio <contact@your-verified-domain.com>
